"""Utilities to load models from Hugging Face and test checkpoints."""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional

import torch
from transformers import AutoModel, AutoModelForCausalLM, AutoTokenizer

from .tensor_inventory import TensorInventory


@dataclass
class ModelSpec:
    """Metadata container for a loaded model instance."""

    name: str
    kind: str = "transformer"
    revision: str = "main"
    device: str = "cpu"
    dtype: str = "float32"
    metadata: Optional[Dict[str, Any]] = None
    model: Optional[Any] = None
    tokenizer: Optional[Any] = None
    inventory: Optional[TensorInventory] = None


class ModelLoader:
    """Load a Hugging Face model and expose its tensor inventory."""

    def __init__(self, model_name: str, *, revision: str = "main", device: str = "cpu") -> None:
        self.model_name = model_name
        self.revision = revision
        self.device = device
        self.model: Optional[Any] = None
        self.tokenizer: Optional[Any] = None

    def load(self, *, trust_remote_code: bool = False) -> ModelSpec:
        """Load a real model and build a tensor inventory.

        Strategy:
        1. Prefer causal LM models for LLM use cases.
        2. Fallback to a generic AutoModel.
        3. Build a TensorInventory automatically from the loaded model.
        """
        resolved_device = self.device
        if resolved_device == "cuda" and not torch.cuda.is_available():
            resolved_device = "cpu"

        model = None
        try:
            model = AutoModelForCausalLM.from_pretrained(
                self.model_name,
                revision=self.revision,
                trust_remote_code=trust_remote_code,
            )
        except Exception:
            try:
                model = AutoModel.from_pretrained(
                    self.model_name,
                    revision=self.revision,
                    trust_remote_code=trust_remote_code,
                )
            except Exception as exc:  # pragma: no cover - network / dependency dependent
                raise RuntimeError(
                    f"Unable to load model '{self.model_name}' from Hugging Face. "
                    f"Check the model name, network access, and installed dependencies."
                ) from exc

        model.to(torch.device(resolved_device))
        model.eval()

        tokenizer = None
        try:
            tokenizer = AutoTokenizer.from_pretrained(self.model_name, revision=self.revision)
        except Exception:  # pragma: no cover - tokenizer may not exist or was not needed
            tokenizer = None

        inventory = TensorInventory.from_model(model)

        self.model = model
        self.tokenizer = tokenizer

        return ModelSpec(
            name=self.model_name,
            kind="transformer",
            revision=self.revision,
            device=resolved_device,
            dtype=str(next(model.parameters()).dtype),
            metadata={
                "loader": "transformers",
                "source": "huggingface",
                "num_parameters": sum(p.numel() for p in model.parameters()),
                "num_layers": len(list(model.modules())),
                "inventory_count": inventory.count(),
            },
            model=model,
            tokenizer=tokenizer,
            inventory=inventory,
        )

    def list_modules(self) -> List[str]:
        """Return the list of module names when a real model is already loaded."""
        if self.model is None:
            return ["embed_tokens", "self_attn", "mlp", "lm_head"]
        return [name for name, _ in self.model.named_modules()]


__all__ = ["ModelLoader", "ModelSpec"]
